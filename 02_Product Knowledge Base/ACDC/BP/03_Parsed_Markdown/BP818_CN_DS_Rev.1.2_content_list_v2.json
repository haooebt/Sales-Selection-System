                ],
                "html": "<table><tr><td>符号</td><td>参数</td><td>参数范围</td><td>单位</td></tr><tr><td> $V_{ISO}$ </td><td>绝缘电压</td><td>5000</td><td>Vrms</td></tr><tr><td> $P_{DMAX}$ </td><td>最大功耗(注2)</td><td>300</td><td>mW</td></tr><tr><td> $T_{OPR}$ </td><td>工作温度范围</td><td>-55 to +125</td><td>°C</td></tr><tr><td> $T_{STG}$ </td><td>存储温度范围</td><td>-55 to +150</td><td>°C</td></tr><tr><td> $T_{LEAD}$ </td><td>最高焊接温度(注3)</td><td>265</td><td>°C</td></tr></table>",
                "table_type": "simple_table",
                "table_nest_level": 1
            },
            "bbox": [
