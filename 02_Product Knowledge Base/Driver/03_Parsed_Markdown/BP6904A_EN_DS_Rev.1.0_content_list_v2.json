    [
        {
            "type": "title",
            "content": {
                "title_content": [
                    {
                        "type": "text",
                        "content": "Description"
                    }
                ],
                "level": 2
            },
            "bbox": [
                100,
                137,
                223,
                158
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "The BP6904A is a high voltage, high speed halfbridge pre-driver for power MOSFET and IGBT. It has one input for high side and low side, and two output channels with internal dead time to avoid cross-conduction."
                    }
                ]
            },
            "bbox": [
                97,
                167,
                485,
                258
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "The input logic level is compatible with 3.3V/5V/15V signal. The floating high side channel can drive a Nchannel power MOSFET or IGBT up to 600V."
                    }
                ]
            },
            "bbox": [
                97,
                259,
                485,
                315
            ]
        },
        {
            "type": "title",
            "content": {
                "title_content": [
                    {
                        "type": "text",
                        "content": "Features"
                    }
                ],
                "level": 2
            },
            "bbox": [
                512,
                137,
                608,
                156
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "<sup>◼</sup> Floating channel operation up to 600V"
                    }
                ]
            },
            "bbox": [
                510,
                167,
                831,
                184
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "<sup>◼</sup> Single input for high side and low side"
                    }
                ]
            },
            "bbox": [
                512,
                185,
                831,
                203
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "<sup>◼</sup> Shut down input turns off both channels"
                    }
                ]
            },
            "bbox": [
                512,
                204,
                840,
                219
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "<sup>◼</sup> Robust at negative transient voltage"
                    }
                ]
            },
            "bbox": [
                512,
                223,
                810,
                240
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "<sup>◼</sup> Gate drive supply range from 10V to 20V"
                    }
                ]
            },
            "bbox": [
                512,
                241,
                850,
                258
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "<sup>◼</sup> 3.3V, 5V and 15V input logic compatible"
                    }
                ]
            },
            "bbox": [
                512,
                259,
                848,
                275
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "<sup>◼</sup> UVLO for both high side and low side"
                    }
                ]
            },
            "bbox": [
                512,
                278,
                828,
                294
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "<sup>◼</sup> Built-in dead time"
                    }
                ]
            },
            "bbox": [
                512,
                297,
                685,
                313
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "<sup>◼</sup> Available in SOP8 package"
                    }
                ]
            },
            "bbox": [
                512,
                315,
                749,
                332
            ]
        },
