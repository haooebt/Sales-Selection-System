                137,
                223,
                158
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "The BP6903A is a high voltage, high speed halfbridge pre-driver for power MOSFET and IGBT. It has inputs for both high side and low side, and two output channels with internal dead time to avoid cross-conduction."
                    }
                ]
            },
            "bbox": [
                97,
                167,
                485,
                259
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "The input logic level is compatible with 3.3V/5V/15V signal. The floating high side channel can drive a Nchannel power MOSFET or IGBT up to 600V."
                    }
                ]
            },
            "bbox": [
                99,
                262,
                485,
                318
            ]
        },
        {
            "type": "title",
            "content": {
                "title_content": [
                    {
                        "type": "text",
                        "content": "Features"
                    }
                ],
                "level": 2
            },
            "bbox": [
                512,
                137,
                608,
                156
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "<sup>◼</sup> Floating channel operation up to 600V"
                    }
                ]
            },
            "bbox": [
                512,
                167,
                830,
                184
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "<sup>◼</sup> Robust at negative transient voltage"
                    }
                ]
            },
            "bbox": [
                512,
                186,
                811,
                202
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "<sup>◼</sup> Gate drive supply range from 10V to 20V"
                    }
                ]
            },
            "bbox": [
                512,
                204,
                850,
                219
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "<sup>◼</sup> 3.3V, 5V and 15V input logic compatible"
                    }
                ]
            },
            "bbox": [
                512,
                223,
                847,
                240
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "<sup>◼</sup> Reverse input for low side"
                    }
                ]
            },
            "bbox": [
                512,
                241,
                744,
                258
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "<sup>◼</sup> UVLO for both high side and low side"
                    }
                ]
            },
            "bbox": [
                512,
                259,
                828,
                275
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "<sup>◼</sup> Built-in dead time"
                    }
                ]
            },
            "bbox": [
                512,
                278,
                685,
                294
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
