                        "content": "PCB 设计"
                    }
                ],
                "level": 2
            },
            "bbox": [
                99,
                249,
                174,
                263
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "在设计BP5132HC的PCB板时，需要注意以下事项："
                    }
                ]
            },
            "bbox": [
                100,
                267,
                480,
                284
            ]
        },
        {
            "type": "title",
            "content": {
                "title_content": [
                    {
                        "type": "text",
                        "content": "地线"
                    }
                ],
                "level": 2
            },
            "bbox": [
                100,
                294,
                142,
                311
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "电流采样电阻的功率地线尽可能短。地/Drain 的面积要尽可能大，以减小热阻，增强散热能力。"
                    }
                ]
            },
            "bbox": [
                99,
                322,
                484,
                359
            ]
        },
        {
            "type": "title",
            "content": {
                "title_content": [
                    {
                        "type": "text",
                        "content": "芯片散热片"
                    }
                ],
                "level": 2
            },
            "bbox": [
                100,
                369,
                194,
                385
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "BP5132HC 芯片底部有增强散热能力的散热片。在设计 PCB 时，为了达到良好的散热效果，需要将散热片连接的铜皮面积尽量大。"
                    }
                ]
            },
            "bbox": [
                99,
                395,
                484,
                451
            ]
        },
