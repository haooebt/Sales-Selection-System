            "bbox": [
                512,
                121,
                561,
                141
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "◆ 外围电路非常简单，驱动器体积非常小"
                    }
                ]
            },
            "bbox": [
                512,
                153,
                813,
                170
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "◆ 无需磁性元件"
                    }
                ]
            },
            "bbox": [
                514,
                173,
                647,
                189
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "◆ 500V 高压 MOS管，无需压敏电阻"
                    }
                ]
            },
            "bbox": [
                514,
                193,
                794,
                210
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "◆ 超快 LED 启动"
                    }
                ]
            },
            "bbox": [
                514,
                214,
                653,
                230
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "◆ ±5% LED 输出电流精度"
                    }
                ]
            },
            "bbox": [
                514,
                234,
                719,
                250
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "◆ LED 电流可外部设定"
                    }
                ]
            },
            "bbox": [
                514,
                254,
                695,
                269
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "◆ 过温调节功能"
                    }
                ]
            },
            "bbox": [
                514,
